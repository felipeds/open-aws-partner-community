# ===========================================================================
# CoE AWS Agents — Environment Variables
# Copy this file to .env and fill in the values for your environment
# ===========================================================================

# --- Authentication (optional — Google OAuth via NextAuth) ---
# Leave GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET empty to run without authentication
NEXTAUTH_SECRET=           # openssl rand -base64 32 (MUST be identical in frontend and backend)
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=          # From Google Cloud Console (leave empty to disable auth)
GOOGLE_CLIENT_SECRET=      # From Google Cloud Console (leave empty to disable auth)

# --- Access Control ---
ALLOWED_DOMAIN=example.com              # Email domain restriction (e.g. yourcompany.com)
PRIVILEGED_EMAILS=                      # Comma-separated list of emails with elevated access
APN_ALLOWED_EMAILS=                     # Comma-separated list of emails authorized for Partner Central agent

# --- AWS General ---
AWS_REGION=us-east-1
AWS_PROFILE=                            # AWS CLI profile (local dev only)

# --- AWS Partner Central (APN Agent) ---
# Required only if using the Partner Central agent
APN_ACCESS_KEY_ID=                      # IAM user with partnercentral-selling permissions
APN_SECRET_ACCESS_KEY=                  # Corresponding secret key
APN_MCP_ENDPOINT=https://partnercentral-agents-mcp.us-east-1.api.aws

# --- AgentCore Runtime (optional — enables observability) ---
# If not set, agents run locally without AgentCore
AGENTCORE_RUNTIME_ARN=                  # e.g. arn:aws:bedrock-agentcore:us-east-1:123456789012:runtime/my-agent-xyz
AGENTCORE_RUNTIME=                      # Set to "true" ONLY inside the AgentCore container (auto-set in Dockerfile.agentcore)

# --- Observability ---
SERVICE_NAME=coe-aws-agents             # Service name for OpenTelemetry traces
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# --- Document Generation (Project Plan Agent) ---
PARTNER_NAME=Your Company               # Partner name used in generated documents

# --- Frontend ---
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001    # Backend URL (change for production)
CORS_ORIGINS=*                                  # Comma-separated allowed origins (restrict in production, e.g. https://yourdomain.com)
